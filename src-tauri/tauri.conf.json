{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostWhisper",
  "version": "0.2.0",
  "identifier": "com.ghostwhisper.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "",
        "width": 700,
        "height": 118,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "center": true
      },
      {
        "label": "menu",
        "title": "",
        "width": 300,
        "height": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true,
        "visible": false,
        "center": false
      },
      {
        "label": "ask",
        "title": "",
        "width": 1040,
        "height": 110,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "center": true
      },
      {
        "label": "capture",
        "title": "",
        "width": 240,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "GhostWhisper — Configurações",
        "width": 1020,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "suggestions",
        "title": "GhostWhisper — Sugestões",
        "width": 540,
        "height": 680,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "center": true
      },
      {
        "label": "chat",
        "title": "GhostWhisper — Transcrição",
        "width": 560,
        "height": 720,
        "minWidth": 360,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "center": true
      },
      {
        "label": "history",
        "title": "GhostWhisper — Histórico",
        "width": 560,
        "height": 680,
        "minWidth": 320,
        "minHeight": 240,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false,
        "center": true
      },
      {
        "label": "recording-picker",
        "title": "Gravar janela",
        "width": 440,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true
      },
      {
        "label": "session-end",
        "title": "Sessão Finalizada",
        "width": 560,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Copiloto de reunião local",
    "longDescription": "GhostWhisper transcreve, traduz e sugere respostas em tempo real, localmente, sem conta e sem telemetria.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libpulse0",
          "libvulkan1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "usr/lib/libvulkan.so.1": "resources/libvulkan.so.1"
        }
      }
    },
    "resources": {
      "resources/laya/multilingual": "laya/multilingual"
    }
  }
}
