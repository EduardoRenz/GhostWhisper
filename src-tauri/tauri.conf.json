{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostWhisper",
  "version": "0.1.0",
  "identifier": "com.ghostwhisper.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "",
        "width": 900,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "center": true
      },
    {
      "label": "settings",
      "title": "GhostWhisper — Configurações",
      "width": 520,
      "height": 640,
      "resizable": true,
      "visible": false,
      "alwaysOnTop": true,
      "center": true
    },
    {
      "label": "suggestions",
      "title": "GhostWhisper — Sugestões",
      "width": 540,
      "height": 680,
      "minWidth": 320,
      "minHeight": 240,
      "resizable": true,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "shadow": false,
      "focus": false,
      "visible": false,
      "center": true
    },
    {
      "label": "chat",
      "title": "GhostWhisper — Transcrição",
      "width": 560,
      "height": 720,
      "minWidth": 360,
      "minHeight": 320,
      "resizable": true,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "shadow": false,
      "focus": false,
      "visible": false,
      "center": true
    },
    {
      "label": "history",
      "title": "GhostWhisper — Histórico",
      "width": 560,
      "height": 680,
      "minWidth": 320,
      "minHeight": 240,
      "resizable": true,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "shadow": false,
      "focus": false,
      "visible": false,
      "center": true
    },
    {
      "label": "dwell",
      "title": "",
      "width": 260,
      "height": 60,
      "resizable": false,
      "decorations": false,
      "transparent": true,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "shadow": false,
      "focus": false,
      "visible": false,
      "center": false
    }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Copiloto de reunião local",
    "longDescription": "GhostWhisper transcreve, traduz e sugere respostas em tempo real, localmente, sem conta e sem telemetria.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libpulse0",
          "libvulkan1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "usr/lib/libvulkan.so.1": "resources/libvulkan.so.1"
        }
      }
    }
  }
}
